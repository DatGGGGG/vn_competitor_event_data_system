# Version-controlled Compass model policy.
#
# Keep credentials in the ignored deploy/docker/pipeline.env file. Docker Compose
# loads this file after pipeline.env, so the selected models stay consistent on
# every environment that pulls this repository.

# High-volume Facebook post classification and legacy Facebook merge work.
OPENAI_MODEL=gpt-5.6-luna
OPENAI_FB_MERGE_MODEL=gpt-5.6-luna

# Quality-sensitive unified event grouping, consolidation, and harvest work.
OPENAI_UNIFIED_EVENT_MERGE_MODEL=gpt-5.6-terra
